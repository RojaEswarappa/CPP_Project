#include <iostream>
#include <cstring>
#include <string>
using namespace std;
class String{
    char *ptr;
    int size;
    public:
    String(){
        size=0;
        ptr=new char[1];
        ptr[0]='\0';
    }
    String(const char *a)
    { 
       size= strlen(a);
       ptr=new char[size+1];
       strcpy(ptr,a);
    }
      const char* c_str() const
    {return ptr;}
    String (const String &obj)
    {
        size=obj.size;
        ptr=new char[size+1];
        strcpy(ptr,obj.c_str());
        
    }
    
  
    ~String(){delete[] ptr;}
    String& operator =(const String &obj)
    {
        if(this!=&obj)
        {
            delete[] ptr;
            size=obj.size;
            ptr=new char[size+1];
            strcpy(ptr,obj.c_str());
        }return *this;
    }
  
    
      void get()
      {
          cout<<ptr<<endl;
      }
};


int main() {
   String s("roja");
   String s2=s;
   String s3;
   s3=s;
   s.get();
   s2.get();
   s3.get();

    return 0;
}
